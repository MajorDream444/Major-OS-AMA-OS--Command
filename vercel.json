{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "python3 maim/build.py",
  "outputDirectory": "maim/dist",
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/pillars", "destination": "/pillars.html" },
    { "source": "/return", "destination": "/return.html" }
  ],
  "redirects": [
    { "source": "/10-pillars", "destination": "/pillars", "permanent": true },
    { "source": "/thank-you", "destination": "/return", "permanent": false }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    },
    {
      "source": "/(favicon|social-preview).(png|svg)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, immutable" }
      ]
    }
  ]
}
